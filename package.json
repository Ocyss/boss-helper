{
  "name": "boss-helper",
  "displayName": "BossHelper",
  "version": "0.5.3-2",
  "private": true,
  "description": "Boss直聘助手, 皆在减少投递简历的麻烦, 和提高投递简历的效率,技术栈使用VIte + Vue3 + element-plus",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "check": "vue-tsc --noEmit",
    "build": "run-p build:chrome build:firefox build:edge",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:edge": "wxt build -b edge",
    "zip": "run-p zip:chrome zip:firefox zip:edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:edge": "wxt zip -b edge",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/openai": "^4.0.99",
    "@nuxt/ui": "^4.12.0",
    "@vueuse/integrations": "^15.0.0",
    "ai": "^7.0.148",
    "codejar": "^4.3.0",
    "comctx": "^1.7.6",
    "devlog-ui": "workspace:*",
    "idb": "^8.0.4",
    "mqtt": "^5.16.1",
    "partial-json": "^0.1.7",
    "serialize-error": "^13.0.2",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.2.4",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "proto2api": "^0.0.8",
    "protobufjs": "^8.8.1",
    "puppeteer": "^25.16.0",
    "sass": "^1.106.0",
    "ts-proto": "^2.18.0",
    "typescript": "^7.0.2",
    "uid": "^2.0.2",
    "vite-plugin-tailwind-shadowdom": "^1.1.1",
    "vue-tsc": "^3.3.13",
    "wxt": "0.21.4"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "oxlint --fix"
  }
}
